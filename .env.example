# Market API / Indexer. Machine PostgreSQL after infra/local-pg.sql.
# Do not start Docker Postgres while postgresql-x64-17 already owns :5432.
DATABASE_URL=postgres://cpm:cpm@127.0.0.1:5432/cpm
RPC_URL=http://127.0.0.1:8899
LISTEN=127.0.0.1:8080

# Emergency only — journals vanish on restart. Never production.
# ALLOW_MEMORY_ONLY=1

# local | staging | production. Non-local forbids ALLOW_MEMORY_ONLY.
# staging/production: empty REVIEWER_PUBKEYS denies all reviewers (fail closed).
CPM_ENV=local
# Comma-separated. Empty + local = any wallet may review.
# REVIEWER_PUBKEYS=
# OPERATOR_PUBKEYS=
# ALLOW_UNREVIEWED_CREATE=1
# GEOIP_DEFAULT_COUNTRY=US
# GEOIP_FAIL_CLOSED=1
# EVIDENCE_DIR=tmp/evidence
# Shed quote/info/pdf/list with HTTP 503 when index lag exceeds this (0 = off). FR-IDX-01.
INDEX_LAG_SHED_SLOTS=128
KEEPER_HEARTBEAT_PATH=tmp/keeper-heartbeat.json
# KEEPER_LEASE_PATH=tmp/keeper-lease.json
# KEEPER_LEASE_SECS=30
NOTIFY_DIR=tmp/notify
JOURNAL_REPLICA_DIR=journal-replica
JOURNAL_OBJECT_DIR=journal-object
