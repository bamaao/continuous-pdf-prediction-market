# Market API / Indexer. Machine PostgreSQL after infra/local-pg.sql.
# Do not start Docker Postgres while postgresql-x64-17 already owns :5432.
DATABASE_URL=postgres://cpm:cpm@127.0.0.1:5432/cpm
RPC_URL=http://127.0.0.1:8899
LISTEN=127.0.0.1:8080

# Emergency only — journals vanish on restart. Never production.
# ALLOW_MEMORY_ONLY=1

# local | staging | production. Non-local forbids ALLOW_MEMORY_ONLY.
CPM_ENV=local
KEEPER_HEARTBEAT_PATH=tmp/keeper-heartbeat.json
NOTIFY_DIR=tmp/notify
JOURNAL_REPLICA_DIR=journal-replica
JOURNAL_OBJECT_DIR=journal-object
