# Server-side runtime env. Copy to $STAGING_REMOTE_DIR/deploy/runtime.env on the host.
# Sourced by scripts/staging-on-server.sh. CPM_ENV=staging forbids ALLOW_MEMORY_ONLY.

CPM_ENV=staging

# Test L1 RPC (Solana devnet, private test validator, or MagicBlock-hosted L1).
RPC_URL=https://api.devnet.solana.com

# MagicBlock test ER RPC (required for session fills / gateway).
ER_RPC=https://devnet.magicblock.app

# Bind addresses on the staging host (or 0.0.0.0 if behind a reverse proxy).
LISTEN_API=127.0.0.1:8080
LISTEN_GW=127.0.0.1:8081

# Public URLs the browser uses (must be reachable by clients).
PUBLIC_RPC_URL=https://api.devnet.solana.com
PUBLIC_MARKET_API=https://staging.example.com/api
PUBLIC_GATEWAY=https://staging.example.com/gw
PUBLIC_CHAIN_ID=devnet
PUBLIC_WEB_ORIGIN=https://staging.example.com

DATABASE_URL=postgres://cpm:cpm@127.0.0.1:5432/cpm
EMBED_INDEXER=1

# Protocol / ops (must match on-chain Protocol.platform after protocol-init).
PLATFORM_PUBKEY=
REVIEWER_PUBKEYS=
OPERATOR_PUBKEYS=

# Non-default secret required when CPM_ENV=staging.
SIWS_SECRET=

# Optional protocol clocks for a fresh Protocol PDA (seconds).
# PROTOCOL_REPORT_WINDOW_SECS=86400
# PROTOCOL_CHALLENGE_SECS=3600
# PROTOCOL_COMMITTEE_BOND=100
# PROTOCOL_FEE_BPS=0
# PROTOCOL_TAP_CAP_MAX=0
# PROTOCOL_ALPHA_R_BPS=7000

# Solana CLI keypair on the server (pays deploy / protocol-init / vault-init).
SOLANA_KEYPAIR=/opt/cpm/keys/deployer.json

# Build vault with Circle devnet USDC mint when the test L1 uses that mint.
# Set 0 if the test cluster still uses the fixture / mainnet mint address.
VAULT_FEATURES_DEVNET=1

INDEXER_POLL_MS=60000
INDEX_LAG_SHED_SLOTS=128
NOTIFY_DIR=/opt/cpm/var/notify
JOURNAL_REPLICA_DIR=/opt/cpm/var/journal-replica
JOURNAL_OBJECT_DIR=/opt/cpm/var/journal-object
KEEPER_HEARTBEAT_PATH=/opt/cpm/var/keeper-heartbeat.json
RECEIPT_DIR=/opt/cpm/var/receipts
