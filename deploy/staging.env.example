# Copy to deploy/staging.env (gitignored) and fill in. Used by scripts/deploy-staging.sh
# from a Linux admin host (Ubuntu/CentOS). Staging servers are Linux only — not Windows.
# Never commit real hosts or keys.

# SSH target
STAGING_SSH=deploy@staging.example.com
STAGING_SSH_PORT=22
# Optional: IdentityFile
# STAGING_SSH_IDENTITY=~/.ssh/id_ed25519

# Absolute path on the server where the repo lives (created on first sync).
STAGING_REMOTE_DIR=/opt/cpm

# Sync mode: rsync (default) or git (server must already be a clone with a remote).
STAGING_SYNC=rsync

# After sync, run build + restart on the server (1) or sync only (0).
STAGING_REMOTE_BUILD=1
STAGING_REMOTE_RESTART=1

# Optional: also deploy .so to the test L1 from the server (needs program keypairs).
STAGING_DEPLOY_PROGRAMS=0
